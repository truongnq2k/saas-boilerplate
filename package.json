{
  "name": "saas-base-boilerplate",
  "version": "1.0.0",
  "description": "A clean SaaS base boilerplate with Fastify, Prisma, and JWT authentication. Ready for building any SaaS application.",
  "main": "dist/server.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/**/*",
    "prisma/**/*",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "start": "node -r module-alias/register -r tsconfig-paths/register dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only --clear --watch src --notify=false --debounce 2000 -r tsconfig-paths/register src/server.ts",
    "build": "prisma generate && tsc",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:seed": "ts-node prisma/seed.ts",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "format": "prettier --write \"src/**/*.{ts,js,json}\""
  },
  "keywords": [
    "fastify",
    "prisma",
    "jwt",
    "authentication",
    "saas",
    "boilerplate",
    "typescript",
    "mysql",
    "rest-api",
    "nodejs",
    "backend",
    "api",
    "security",
    "multi-tenancy"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": ""
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "_moduleAliases": {
    "@": "./dist"
  },
  "dependencies": {
    "@fastify/compress": "~8.3.0",
    "@fastify/cors": "~11.1.0",
    "@fastify/multipart": "~9.4.0",
    "@fastify/rate-limit": "~10.3.0",
    "@fastify/static": "~8.3.0",
    "@fastify/swagger": "~9.7.0",
    "@fastify/swagger-ui": "~5.2.5",
    "@prisma/client": "~6.19.3",
    "bcryptjs": "~3.0.2",
    "fastify": "~5.8.5",
    "ioredis": "~5.10.1",
    "jsonwebtoken": "~9.0.2",
    "module-alias": "~2.3.4",
    "node-cron": "~3.0.3",
    "tsconfig-paths": "~4.2.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "~2.4.6",
    "@types/jsonwebtoken": "~9.0.10",
    "@types/module-alias": "~2.0.4",
    "@types/node": "~24.12.2",
    "@types/node-cron": "~3.0.11",
    "prisma": "~6.19.3",
    "ts-node-dev": "~2.0.0",
    "typescript": "~5.9.3"
  }
}
