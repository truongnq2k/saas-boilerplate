PORT=8888
DATABASE_URL="mysql://root:password@localhost:3306/saas_db"
JWT_SECRET="your-jwt-secret-key"
JWT_REFRESH_SECRET="your-jwt-refresh-secret-key"
CORS_ORIGINS=http://localhost:3000,http://localhost:8888,https://yourdomain.com
X_HEADER_KEY="your-api-key"

NODE_ENV=development
HOST=localhost
API_BASE_URL=api.example.com

REDIS_URL="redis://localhost:6379"

LOG_LEVEL=info

# Email
EMAIL_PROVIDER=console          # console | smtp | sendgrid
EMAIL_FROM=noreply@example.com
EMAIL_FROM_NAME="SaaS App"
APP_URL=http://localhost:3000

# SMTP (required if EMAIL_PROVIDER=smtp)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# SendGrid (required if EMAIL_PROVIDER=sendgrid)
SENDGRID_API_KEY=
